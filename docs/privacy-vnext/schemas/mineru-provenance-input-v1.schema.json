{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shilittle/Lawyer-Assistance/blob/main/docs/privacy-vnext/schemas/mineru-provenance-input-v1.schema.json",
  "title": "MinerU production redistribution provenance input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provenanceVersion", "approval", "source", "cpython", "runtimeProfile", "distributions", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provenanceVersion": { "const": "lawyer-assistance-mineru-provenance-input-v1" },
    "approval": { "$ref": "#/$defs/approval" },
    "source": { "$ref": "#/$defs/source" },
    "cpython": { "$ref": "#/$defs/cpython" },
    "runtimeProfile": { "$ref": "#/$defs/runtimeProfile" },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/distribution" }
    },
    "models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sizeBytes", "sha256"],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedForRedistribution", "reviewer", "reviewedAtUnix"],
      "properties": {
        "approvedForRedistribution": { "type": "boolean" },
        "reviewer": { "type": "string", "maxLength": 128 },
        "reviewedAtUnix": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryCommit", "buildScriptSha256", "workerSourceTreeSha256"],
      "properties": {
        "repositoryCommit": { "$ref": "#/$defs/revision" },
        "buildScriptSha256": { "$ref": "#/$defs/sha256" },
        "workerSourceTreeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cpython": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceUrl", "contentSha256", "license", "licenseFileSha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "license": { "type": "string", "minLength": 1, "not": { "enum": ["NOASSERTION", "UNKNOWN"] } },
        "licenseFileSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "rootDistribution", "extras"],
      "properties": {
        "platform": { "const": "windows-x86_64" },
        "rootDistribution": { "const": "mineru==3.4.3" },
        "extras": { "const": ["pipeline", "vlm"] }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "contentSha256", "sourceUrl", "license", "licenseEvidenceKind", "licenseFiles", "installationRecord", "upstreamArtifact"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
        "version": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "license": { "type": "string", "minLength": 1, "not": { "enum": ["NOASSERTION", "UNKNOWN"] } },
        "licenseEvidenceKind": { "enum": ["metadata-license-expression", "metadata-license", "metadata-license-classifier"] },
        "licenseFiles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/file" } },
        "installationRecord": { "$ref": "#/$defs/file" },
        "upstreamArtifact": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/upstreamArtifact" }
          ]
        }
      }
    },
    "upstreamArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sourceUrl", "sha256"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+\\.whl$" },
        "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "name", "revision", "sourceUrl", "license", "licenseEvidenceUrl", "files"],
      "properties": {
        "root": { "enum": ["pipeline", "vlm"] },
        "name": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "license": { "type": "string", "minLength": 1, "not": { "enum": ["NOASSERTION", "UNKNOWN"] } },
        "licenseEvidenceUrl": { "$ref": "#/$defs/httpsUrl" },
        "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/file" } }
      }
    }
  }
}
