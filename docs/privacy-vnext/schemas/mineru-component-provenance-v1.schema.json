{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shilittle/Lawyer-Assistance/blob/main/docs/privacy-vnext/schemas/mineru-component-provenance-v1.schema.json",
  "title": "Packaged MinerU component provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provenanceVersion", "provenanceInputSha256", "approval", "source", "cpython", "runtimeProfile", "distributions", "excludedDistributions", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provenanceVersion": { "const": "lawyer-assistance-mineru-component-provenance-v1" },
    "provenanceInputSha256": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/sha256" },
    "approval": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/approval" },
    "source": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/source" },
    "cpython": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/cpython" },
    "runtimeProfile": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/runtimeProfile" },
    "models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/model" }
    },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "contentSha256", "packagedContentSha256", "sourceUrl", "license", "licenseEvidenceKind", "licenseFiles", "installationRecord", "upstreamArtifact"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
          "version": { "type": "string", "minLength": 1 },
          "contentSha256": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/sha256" },
          "packagedContentSha256": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/sha256" },
          "sourceUrl": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/httpsUrl" },
          "license": { "type": "string", "minLength": 1, "not": { "enum": ["NOASSERTION", "UNKNOWN"] } },
          "licenseEvidenceKind": { "enum": ["metadata-license-expression", "metadata-license", "metadata-license-classifier"] },
          "licenseFiles": { "type": "array", "uniqueItems": true, "items": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/file" } },
          "installationRecord": { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/file" },
          "upstreamArtifact": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "mineru-provenance-input-v1.schema.json#/$defs/upstreamArtifact" }
            ]
          }
        }
      }
    },
    "excludedDistributions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "reason"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "reason": { "const": "outside-mineru-pipeline-vlm-dependency-closure" }
        }
      }
    }
  }
}
