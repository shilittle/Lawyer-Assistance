{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawyer-assistance.local/schemas/privacy-evaluation-corpus-v1.schema.json",
  "title": "Lawyer Assistance Offline Privacy Evaluation Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "detectorVersion", "policyVersion", "syntheticOnly", "items"],
  "properties": {
    "schemaVersion": { "const": "privacy-evaluation-corpus-v1" },
    "corpusId": { "$ref": "#/$defs/token" },
    "detectorVersion": { "$ref": "#/$defs/token" },
    "policyVersion": { "$ref": "#/$defs/token" },
    "syntheticOnly": { "type": "boolean" },
    "items": { "type": "array", "minItems": 1, "maxItems": 10000000, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "entity": {
      "enum": ["person_name", "organization_name", "case_number", "identity_number", "passport_number", "phone_number", "landline_number", "bank_account", "email_address", "address", "organization_code", "business_license_number", "vehicle_plate", "ip_address", "social_account", "payment_account", "account_name", "contract_number", "tracking_number", "property_certificate_number", "custom"]
    },
    "severity": { "enum": ["p0_blocking", "p1_high", "p2_medium", "p3_resolved", "informational"] },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "documentId", "entityType", "expectedSensitive", "predictedSensitive", "matchedGroundTruth", "confidencePpm", "autoApprovalCandidate", "humanModified", "expectedSeverity", "ocrStratum"],
      "properties": {
        "itemId": { "$ref": "#/$defs/token" },
        "documentId": { "$ref": "#/$defs/token" },
        "entityType": { "$ref": "#/$defs/entity" },
        "expectedSensitive": { "type": "boolean" },
        "predictedSensitive": { "type": "boolean" },
        "matchedGroundTruth": { "type": "boolean" },
        "confidencePpm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "autoApprovalCandidate": { "type": "boolean" },
        "humanModified": { "type": "boolean" },
        "expectedSeverity": { "$ref": "#/$defs/severity" },
        "ocrStratum": { "$ref": "#/$defs/token" }
      }
    }
  }
}
