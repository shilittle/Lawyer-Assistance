{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "mcp": {
    "lawyer_assistance": {
      "type": "local",
      "command": ["/absolute/path/to/lawyer-assistance-mcp", "--privacy-profile", "public_law_only", "stdio"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "LAWYER_ASSISTANCE_LEGAL_DB": "/absolute/path/to/legal_core.sqlite",
        "LAWYER_ASSISTANCE_USER_DB": "/absolute/path/to/user.sqlite",
        "LAWYER_ASSISTANCE_ALLOWED_ROOTS": "/absolute/path/to/cases",
        "LAWYER_ASSISTANCE_OUTPUT_ROOT": "/absolute/path/to/exports"
      }
    }
  },
  "permission": {
    "lawyer_assistance_*": "deny",
    "lawyer_assistance_system_status": "allow",
    "lawyer_assistance_legal_search": "allow",
    "lawyer_assistance_legal_get_article": "allow",
    "lawyer_assistance_legal_get_versions": "allow",
    "lawyer_assistance_legal_get_relations": "allow"
  }
}