{
  "mcpServers": {
    "lawyer_assistance": {
      "type": "stdio",
      "description": "Qualification-gated Lawyer Assistance approved-case-workspace MCP server (macOS or Linux; exact 15-tool surface)",
      "command": "/opt/lawyer-assistance/bin/lawyer-assistance-mcp",
      "args": ["--privacy-profile", "approved_case_workspace", "stdio"],
      "env": {
        "LAWYER_ASSISTANCE_LEGAL_DB": "/opt/lawyer-assistance/data/legal_core.sqlite",
        "LAWYER_ASSISTANCE_USER_DB": "/opt/lawyer-assistance/data/user.sqlite",
        "LAWYER_ASSISTANCE_ALLOWED_ROOTS": "/srv/lawyer-assistance/empty-input",
        "LAWYER_ASSISTANCE_OUTPUT_ROOT": "/srv/lawyer-assistance/work-products"
      }
    }
  }
}
