{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawyer-assistance://schemas/diagram-spec/1.0",
  "title": "Lawyer Assistance DiagramSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "template_id",
    "title",
    "summary",
    "nodes",
    "edges",
    "groups",
    "sources",
    "layout_hints",
    "display_options",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "diagram_type": { "$ref": "#/$defs/diagram_type" },
    "template_id": { "$ref": "#/$defs/template_id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "summary": { "type": "string", "maxLength": 4096 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 1200,
      "items": { "$ref": "#/$defs/edge" }
    },
    "groups": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/group" }
    },
    "sources": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/source" }
    },
    "layout_hints": { "$ref": "#/$defs/layout_hints" },
    "display_options": { "$ref": "#/$defs/display_options" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "diagram_type": {
      "type": "string",
      "enum": [
        "legal_hierarchy",
        "legal_application_chain",
        "legal_conflict_priority",
        "case_party_relationship",
        "case_issue_evidence_law",
        "case_money_flow",
        "case_timeline"
      ]
    },
    "template_id": {
      "type": "string",
      "enum": [
        "legal_hierarchy_v1",
        "legal_application_chain_v1",
        "legal_conflict_priority_v1",
        "case_party_relationship_v1",
        "case_issue_evidence_law_v1",
        "case_money_flow_v1",
        "case_timeline_v1"
      ]
    },
    "node_type": {
      "type": "string",
      "enum": [
        "party",
        "account",
        "event",
        "legal_relationship",
        "fact",
        "issue",
        "evidence",
        "rule",
        "claim",
        "defense",
        "amount",
        "procedure",
        "law",
        "regulation",
        "supervisory_regulation",
        "judicial_interpretation",
        "department_rule",
        "local_regulation",
        "local_government_rule",
        "normative_document",
        "guiding_case",
        "legal_principle",
        "element",
        "legal_consequence",
        "exception_rule",
        "application_conclusion",
        "missing_information"
      ]
    },
    "node_status": {
      "type": "string",
      "enum": [
        "alleged",
        "admitted",
        "supported",
        "disputed",
        "contradicted",
        "established",
        "unsupported",
        "unknown",
        "active",
        "inactive",
        "pending",
        "completed",
        "effective",
        "repealed",
        "expired",
        "not_yet_effective",
        "uncertain",
        "not_applicable"
      ]
    },
    "relation": {
      "type": "string",
      "enum": [
        "supports",
        "contradicts",
        "proves",
        "alleges",
        "admits",
        "disputes",
        "raises",
        "applies_to",
        "requires",
        "leads_to",
        "based_on",
        "involves",
        "occurred_before",
        "occurred_after",
        "same_event_as",
        "conflicts_in_time_with",
        "paid_to",
        "transferred_to",
        "owes",
        "guarantees",
        "controls",
        "owns",
        "represents",
        "employs",
        "contracts_with",
        "related_party_of",
        "superior_to",
        "authorized_by",
        "implements",
        "references",
        "supplements",
        "interprets",
        "exception_to",
        "limits",
        "conflicts_with",
        "repeals",
        "amends",
        "replaces",
        "applies_before",
        "contains",
        "belongs_to",
        "related_to"
      ]
    },
    "metadata_scalar": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "metadata_value": {
      "oneOf": [
        { "$ref": "#/$defs/metadata_scalar" },
        {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/metadata_scalar" }
        },
        {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/metadata_scalar" }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/metadata_value" }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "details",
        "status",
        "importance",
        "source_refs",
        "tags",
        "metadata"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/node_type" },
        "subtype": {
          "type": ["string", "null"],
          "maxLength": 96,
          "pattern": "^[a-z0-9_]*$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "short_label": { "type": ["string", "null"], "maxLength": 80 },
        "details": { "type": "string", "maxLength": 16384 },
        "status": { "$ref": "#/$defs/node_status" },
        "importance": {
          "type": "string",
          "enum": ["critical", "high", "normal", "low"]
        },
        "source_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "relation",
        "label",
        "strength",
        "source_refs",
        "metadata"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" },
        "relation": { "$ref": "#/$defs/relation" },
        "label": { "type": "string", "maxLength": 256 },
        "strength": {
          "type": "string",
          "enum": ["conclusive", "strong", "moderate", "weak", "unknown"]
        },
        "source_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "node_ids",
        "collapsed_by_default",
        "source_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "node_ids": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "parent_group_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "collapsed_by_default": { "type": "boolean" },
        "source_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "locator", "verification_status"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "file_page",
            "paragraph",
            "table",
            "attachment",
            "law",
            "case_record",
            "artifact",
            "uri",
            "model_analysis",
            "human_input"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "artifact_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "uri": { "type": ["string", "null"], "maxLength": 2048 },
        "file_name": { "type": ["string", "null"], "maxLength": 256 },
        "page": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000000 },
        "paragraph": { "type": ["string", "null"], "maxLength": 128 },
        "table": { "type": ["string", "null"], "maxLength": 128 },
        "attachment": { "type": ["string", "null"], "maxLength": 128 },
        "law_document": { "type": ["string", "null"], "maxLength": 256 },
        "law_version": { "type": ["string", "null"], "maxLength": 128 },
        "article": { "type": ["string", "null"], "maxLength": 128 },
        "quote": { "type": ["string", "null"], "maxLength": 8192 },
        "content_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "original_material",
            "model_extracted",
            "model_analyzed",
            "database_verified",
            "human_confirmed",
            "unverified"
          ]
        }
      }
    },
    "layout_hints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "preferred_root_ids",
        "group_by",
        "max_initial_nodes",
        "timeline_lane"
      ],
      "properties": {
        "direction": {
          "type": "string",
          "enum": ["top_down", "left_right", "radial", "timeline"]
        },
        "preferred_root_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "group_by": {
          "type": "string",
          "enum": ["none", "node_type", "status", "issue", "party", "source"]
        },
        "max_initial_nodes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 500
        },
        "timeline_lane": {
          "type": "string",
          "enum": ["single", "by_party", "by_procedure", "by_statement"]
        }
      }
    },
    "display_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "show_legend",
        "show_sources",
        "hide_weak_edges",
        "collapse_low_importance",
        "print_page_size"
      ],
      "properties": {
        "theme": { "type": "string", "enum": ["light", "dark", "auto"] },
        "show_legend": { "type": "boolean" },
        "show_sources": { "type": "boolean" },
        "hide_weak_edges": { "type": "boolean" },
        "collapse_low_importance": { "type": "boolean" },
        "print_page_size": {
          "type": "string",
          "enum": ["a4_landscape", "a4_portrait"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_by",
        "generated_at",
        "diagram_spec_version",
        "template_version",
        "source_file_ids",
        "human_confirmed",
        "model_content_scope",
        "deterministic_content_scope"
      ],
      "properties": {
        "generated_by": {
          "type": "string",
          "enum": ["workbuddy", "codex", "local_model", "human", "importer"]
        },
        "generated_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64,
          "format": "date-time"
        },
        "diagram_spec_version": { "const": "1.0" },
        "template_version": { "const": "1.0.0" },
        "source_file_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "human_confirmed": { "type": "boolean" },
        "parent_spec_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "change_summary": { "type": ["string", "null"], "maxLength": 1024 },
        "model_content_scope": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "deterministic_content_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
