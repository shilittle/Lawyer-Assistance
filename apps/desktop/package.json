{
  "name": "@lawyer-assistance/desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && pnpm run verify:frontend-dist",
    "build:tauri": "node scripts/build_tauri_frontend.mjs",
    "lint": "eslint . --max-warnings=0",
    "tauri": "tauri",
    "test": "vitest run",
    "verify:frontend-dist": "node scripts/verify_frontend_dist.mjs",
    "verify:legal-resource": "python scripts/verify_legal_resource.py",
    "release:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_portable_release.ps1",
    "release:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_signed_release.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "cytoscape": "^3.34.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.49.0",
    "vite": "8.1.2",
    "vitest": "4.0.16"
  }
}
