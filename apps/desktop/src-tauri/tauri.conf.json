{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lawyer Assistance",
  "version": "0.1.0",
  "identifier": "com.shilittle.lawyer-assistance",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lawyer Assistance",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": ["resources/legal_core.sqlite"]
  }
}
